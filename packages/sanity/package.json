    "./client": "./src/lib/client.ts",
    "./image": "./src/lib/image.ts",
    "./live": "./src/lib/live.ts",
    "./queries": "./src/lib/queries.ts",
    "./types": "./src/types.ts",
    "./structure": "./src/structure/index.ts",
    "./presentation": "./src/presentation/resolve.ts"
  },
  "dependencies": {
    "@sanity/client": "^7",
    "@sanity/icons": "^3",
    "@sanity/image-url": "^1",
